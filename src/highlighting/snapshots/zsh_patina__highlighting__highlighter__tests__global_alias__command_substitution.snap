echo $(ls C) L

0   4   `echo`  CALLABLE `echo`
4   5   ` `     meta.function-call.arguments
5   6   `$`     punctuation.definition.variable
6   7   `(`     punctuation.section.parens.begin
7   9   `ls`    CALLABLE `ls`
9   10  ` `     meta.function-call.arguments
10  11  `C`     meta.function-call.arguments + dynamic.callable.alias
11  12  `)`     punctuation.section.parens.end
12  13  ` `     meta.function-call.arguments
13  14  `L`     meta.function-call.arguments + dynamic.callable.alias
